{
  "datasets": [
    {
      "name": "1d847d4d",
      "displayName": "Agency Monthly Procurement Spending Summary",
      "config": {
        "version": "1.1",
        "source": "SELECT data_source, month, awarding_agency, net_obligations,\r\n       new_award_obligations, modification_obligations, deobligations\r\nFROM procurement.analytics.gold_spend_by_agency_month",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "6ba60233",
      "displayName": "Top Ten Vendors by Agency Spending Share",
      "config": {
        "version": "1.1",
        "source": "SELECT data_source, awarding_agency, recipient_name, vendor_obligations,\r\n       ROUND(share_of_agency_spend * 100, 1) AS share_pct, rank_in_agency\r\nFROM procurement.analytics.gold_top_vendors\r\nWHERE rank_in_agency <= 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "4bdecec4",
      "displayName": "Vendor Concentration and Awarding Agency Data Summary",
      "config": {
        "version": "1.1",
        "source": "SELECT data_source, awarding_agency, hhi, vendor_count, concentration\r\nFROM procurement.analytics.gold_vendor_concentration",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "57615b8e",
      "displayName": "Vendor Market Share and Awarding Agency Overview",
      "config": {
        "version": "1.1",
        "source": "SELECT data_source, awarding_agency, hhi, vendor_count, concentration\r\nFROM procurement.analytics.gold_vendor_concentration",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
